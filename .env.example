# Configuration du hub. Copier en .env (jamais dans git) : lu par docker compose et par make dev / make start.

# URL par laquelle les agents joignent le hub (sinon : l'adresse utilisée dans le navigateur)
# PUBLIC_URL=http://192.168.1.10:3000

# Fréquence de l'apt-get update automatique sur les hôtes, en heures (0 = désactivé)
# CHECK_INTERVAL_HOURS=12

# Port publié par docker compose
# HUB_PORT=3000

# Image utilisée par docker compose (make docker-up utilise l'image locale homelab-manager:latest)
# HUB_IMAGE=mathmath350/homelab-manager:latest

# MongoDB, hors docker compose uniquement (make dev / make start)
# MONGO_URL=mongodb://localhost:27017/homelab

# TZ=Europe/Paris
# LOG_LEVEL=info          # fatal | error | warn | info | debug
# SESSION_DAYS=30
# COOKIE_SECURE=false     # true si le hub est servi en HTTPS
# TRUST_PROXY=false       # true derrière un reverse proxy
